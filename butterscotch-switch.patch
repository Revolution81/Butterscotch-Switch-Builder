+    if (0 > dst || 0 > src || (uint32_t) dst >= dw->bgnd.count || (uint32_t) src >= dw->bgnd.count) return RValue_makeUndefined();
+    dw->bgnd.backgrounds[dst].tpagIndex = dw->bgnd.backgrounds[src].tpagIndex;
+    dw->bgnd.backgrounds[dst].transparent = dw->bgnd.backgrounds[src].transparent;
+    dw->bgnd.backgrounds[dst].smooth = dw->bgnd.backgrounds[src].smooth;
+    return RValue_makeUndefined();
