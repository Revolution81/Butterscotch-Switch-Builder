+static RValue builtin_filename_ext(VMContext* ctx, RValue* args, int32_t argCount) {
+    REQUIRE_ARGC_AT_LEAST("filename_ext", 1, RValue_makeOwnedString(safeStrdup("")));
+    char* fname = RValue_toString(args[0], ctx->runner->dataWin);
+    if (fname == nullptr) return RValue_makeOwnedString(safeStrdup(""));
+    char* lastBackslash = strrchr(fname, '\\');
+    char* lastSlash = strrchr(fname, '/');
+    char* lastSep = lastBackslash > lastSlash ? lastBackslash : lastSlash;
+    char* dot = strrchr(fname, '.');
+    char* result = (dot != nullptr && (lastSep == nullptr || dot > lastSep)) ? safeStrdup(dot) : safeStrdup("");
+    free(fname);
+    return RValue_makeOwnedString(result);
+}
