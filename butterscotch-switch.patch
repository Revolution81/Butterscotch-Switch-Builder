+static void dsGridFillRegion(DsGrid* grid, int32_t x1, int32_t y1, int32_t x2, int32_t y2, RValue val) {
+    if (x1 > x2) { int32_t t = x1; x1 = x2; x2 = t; }
+    if (y1 > y2) { int32_t t = y1; y1 = y2; y2 = t; }
+    if (0 > x1) x1 = 0;
+    if (0 > y1) y1 = 0;
+    if (x2 >= grid->width) x2 = grid->width - 1;
+    if (y2 >= grid->height) y2 = grid->height - 1;
+    for (int32_t y = y1; y2 >= y; y++) {
+        for (int32_t x = x1; x2 >= x; x++) {
+            RValue* slot = &grid->items[x + (y * grid->width)];
+            RValue_free(slot);
+            *slot = RValue_makeIndependent(val);
+        }
+    }
+}
