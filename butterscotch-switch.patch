+// Seek a streaming instance: drop the queued audio, move the decoder, refill and resume in the same play/pause state.
+static void streamSeek(SoundInstance* inst, float positionSeconds) {
+    if (0 >= inst->streamSampleRate) return;
+    ALint state = 0;
+    alGetSourcei(inst->alSource, AL_SOURCE_STATE, &state);
+    alSourceStop(inst->alSource);
+    ALint queued = 0;
+    alGetSourcei(inst->alSource, AL_BUFFERS_QUEUED, &queued);
+    repeat(queued, i) {
+        ALuint b;
+        alSourceUnqueueBuffers(inst->alSource, 1, &b);
+    }
+
+    uint64_t target = positionSeconds > 0.0f ? (uint64_t) ((double) positionSeconds * (double) inst->streamSampleRate) : 0;
+    if (inst->streamLengthSamples > 0) {
+        if (inst->loop) target %= (uint64_t) inst->streamLengthSamples;
+        else if (target > (uint64_t) inst->streamLengthSamples) target = (uint64_t) inst->streamLengthSamples;
+    }
+    if (inst->vorbis != nullptr) {
+        stb_vorbis_seek((stb_vorbis*) inst->vorbis, (unsigned int) target);
+    } else if (inst->wavFile != nullptr) {
+        uint64_t frameBytes = (uint64_t) inst->streamChannels * sizeof(int16_t);
+        uint64_t offset = target * frameBytes;
+        if (offset > inst->wavDataBytes) offset = inst->wavDataBytes;
+        fseek(inst->wavFile, (long) (inst->wavDataStart + (int64_t) offset), SEEK_SET);
+        inst->wavSampleBytesRemaining = inst->wavDataBytes - (uint32_t) offset;
+    }
+    inst->playedSamples = target;
+    inst->streamEnded = false;
+
+    for (int i = 0; AL_STREAM_BUFFER_COUNT > i; i++) {
+        if (!streamFillBuffer(inst, inst->streamBuffers[i])) { inst->streamEnded = true; break; }
+        alSourceQueueBuffers(inst->alSource, 1, &inst->streamBuffers[i]);
+    }
+    if (state == AL_PLAYING || state == AL_PAUSED) {
+        alSourcePlay(inst->alSource);
+        if (state == AL_PAUSED) alSourcePause(inst->alSource);
+    }
+}
