+static RValue builtin_ds_grid_clear(VMContext* ctx, RValue* args, int32_t argCount) {
+    REQUIRE_ARGC_AT_LEAST("ds_grid_clear", 2, RValue_makeUndefined());
+    DsGrid* grid = dsGridGet(ctx->runner, RValue_toInt32(args[0]));
+    if (grid == nullptr || grid->width <= 0 || grid->height <= 0) return RValue_makeUndefined();
+    dsGridFillRegion(grid, 0, 0, grid->width - 1, grid->height - 1, args[1]);
+    return RValue_makeUndefined();
+}
