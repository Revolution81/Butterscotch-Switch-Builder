+static Room* roomForEditing(VMContext* ctx, int32_t roomId) {
+    DataWin* dw = ctx->runner->dataWin;
+    if (0 > roomId || (uint32_t) roomId >= dw->room.count) return nullptr;
+    Room* room = &dw->room.rooms[roomId];
+    if (!room->payloadLoaded) DataWin_loadRoomPayload(dw, roomId);
+    return room;
