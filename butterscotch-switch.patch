+static RoomTile* findTileById(VMContext* ctx, RValue idValue) {
+    Room* room = ctx->runner->currentRoom;
+    if (room == nullptr) return nullptr;
+    uint32_t id = (uint32_t) RValue_toInt32(idValue);
+    repeat(room->tileCount, i) {
+        if (room->tiles[i].instanceID == id) return &room->tiles[i];
+    }
+    return nullptr;
+}
