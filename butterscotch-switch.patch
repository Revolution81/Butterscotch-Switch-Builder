+        REQUIRE_ARGC_AT_LEAST(#fnName, 1, RValue_makeReal(-1.0)); \
+        RoomTile* tile = findTileById(ctx, args[0]); \
+        if (tile == nullptr) return RValue_makeReal(-1.0); \
+        return RValue_makeReal((GMLReal) (expr)); \
+    }
